{
  "name": "cedian-app",
  "version": "0.1.0",
  "description": "Cedian \u2014 VS Code fork (Electron + TypeScript) UI for the cedian agent",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
