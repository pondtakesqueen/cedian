#!/usr/bin/env bash
# Makes a Cedian source tree from VS Code at the pin in vscode/UPSTREAM (docs/VENDORING.md
# steps 1-4): clones the tag if <dir> is missing, applies vscode/patches, merges
# vscode/product.json over VS Code's (a null removes a key), sets the app icon, and copies
# Cedian's workbench contribution with the window's modules from src/.
# The tree stays outside this repo; rerun on a clean clone to update it.
# Usage: script/vscode/prepare <dir>
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: script/vscode/prepare <dir>" >&2
  exit 2
fi
repo="$(cd "$(dirname "$0")/../.." && pwd)"
dir="$1"
read -r tag sha < "$repo/vscode/UPSTREAM"

if [[ ! -d "$dir/.git" ]]; then
  git clone --depth 1 --branch "$tag" https://github.com/microsoft/vscode "$dir"
fi
head="$(git -C "$dir" rev-parse HEAD)"
if [[ "$head" != "$sha" ]]; then
  echo "$dir is at $head, not VS Code $tag ($sha)" >&2
  exit 1
fi
if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]]; then
  echo "$dir has changes; prepare needs a clean $tag (git -C $dir checkout -- . && git -C $dir clean -fd src/vs/workbench/contrib/cedian)" >&2
  exit 1
fi

for patch in "$repo"/vscode/patches/*.patch; do
  git -C "$dir" apply --whitespace=nowarn "$patch"
  echo "applied $(basename "$patch")"
done

python3 -I - "$dir/product.json" "$repo/vscode/product.json" <<'PY'
import json, sys
path, overrides = sys.argv[1], sys.argv[2]
product = json.load(open(path))
for key, value in json.load(open(overrides)).items():
    if value is None:
        product.pop(key, None)
    else:
        product[key] = value
with open(path, "w") as f:
    json.dump(product, f, indent="\t")
    f.write("\n")
PY
echo "merged product.json"

cp "$repo/brand/AppIcon.icns" "$dir/resources/darwin/code.icns"
cp "$repo/brand/app-icon/macos-1024.png" "$dir/resources/linux/code.png"
# VS Code's build ships licenses/** beside its LICENSE.txt and ThirdPartyNotices.txt.
mkdir -p "$dir/licenses"
cp "$repo/NOTICE" "$dir/licenses/Cedian-NOTICE.txt"

contrib="$dir/src/vs/workbench/contrib/cedian"
rm -rf "$contrib"
cp -R "$repo/vscode/contrib/cedian" "$contrib"
# The window's logic and drawing live in src/ (tested there with vitest); each module dir is
# copied under browser/ as it is, tests left out.
for mod in agent-pane completion composer daemon-client dom inline-edit keybindings protocol review settings theme; do
  mkdir -p "$contrib/browser/$mod"
  for f in "$repo/src/$mod"/*.ts; do
    case "$f" in *.test.ts) continue ;; esac
    cp "$f" "$contrib/browser/$mod/"
  done
done
echo "prepared Cedian at $dir (VS Code $tag)"
