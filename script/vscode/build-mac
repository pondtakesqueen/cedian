#!/usr/bin/env bash
# Builds Cedian.app from a tree script/vscode/prepare made, on a Mac, with the Node version
# VS Code pins (.nvmrc). The app lands next to the tree: <dir>/../VSCode-darwin-<arch>/Cedian.app,
# with cedian-daemon beside its binary in Contents/MacOS (where the window looks for it first),
# signed ad hoc so it runs on the Mac that built it. The Browser block is VS Code's own native
# view, so no Chromium ships beside it.
# Usage: script/vscode/build-mac <dir>
set -euo pipefail
dir="$(cd "${1:?usage: script/vscode/build-mac <dir>}" && pwd)"
arch="$(uname -m)"; [[ "$arch" == "x86_64" ]] && arch=x64
want="v$(cat "$dir/.nvmrc")"
if [[ "$(node --version)" != "$want"* ]]; then
  echo "node $(node --version); VS Code $(cat "$dir/.nvmrc") wants $want (nvm install $want)" >&2
  exit 1
fi
repo="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$dir"
npm ci
npm run gulp "vscode-darwin-$arch-min"
app="$(dirname "$dir")/VSCode-darwin-$arch/Cedian.app"
(cd "$repo/daemon" && cargo build --release --locked -p cedian_daemon --bin cedian-daemon)
# Signed beside the bundle's copy, then renamed over it in one step: macOS kills a daemon that
# launchd or a window starts from a file being rewritten or not yet signed (Code Signature
# Invalid), which is how a rebuild used to take the running daemon down.
cp "$repo/daemon/target/release/cedian-daemon" "$app/Contents/MacOS/cedian-daemon.new"
codesign --force --sign - "$app/Contents/MacOS/cedian-daemon.new"
mv -f "$app/Contents/MacOS/cedian-daemon.new" "$app/Contents/MacOS/cedian-daemon"
# A build from before the native view carried the daemon's Chromium: it goes.
rm -rf "$app/Contents/Resources/chromium"
codesign --force --deep --sign - "$app"
echo "built $app"
