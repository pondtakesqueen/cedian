#!/usr/bin/env bash
# Builds Cedian.app from a tree script/vscode/prepare made, on a Mac, with the Node version
# VS Code pins (.nvmrc). The app lands next to the tree: <dir>/../VSCode-darwin-<arch>/Cedian.app,
# with cedian-daemon beside its binary in Contents/MacOS (where the window looks for it first),
# signed ad hoc so it runs on the Mac that built it.
# Usage: script/vscode/build-mac <dir>
set -euo pipefail
dir="$(cd "${1:?usage: script/vscode/build-mac <dir>}" && pwd)"
arch="$(uname -m)"; [[ "$arch" == "x86_64" ]] && arch=x64
want="v$(cat "$dir/.nvmrc")"
if [[ "$(node --version)" != "$want"* ]]; then
  echo "node $(node --version); VS Code $(cat "$dir/.nvmrc") wants $want (nvm install $want)" >&2
  exit 1
fi
repo="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$dir"
npm ci
npm run gulp "vscode-darwin-$arch-min"
app="$(dirname "$dir")/VSCode-darwin-$arch/Cedian.app"
(cd "$repo/daemon" && cargo build --release --locked -p cedian_daemon --bin cedian-daemon)
cp "$repo/daemon/target/release/cedian-daemon" "$app/Contents/MacOS/cedian-daemon"
codesign --force --deep --sign - "$app"
echo "built $app"
