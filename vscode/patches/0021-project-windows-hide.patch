  * page, see `CodeWindow`). Their background stays clear: a theme change must not paint it over.
  */
 export const vibrantWindowIds = new Set<number>();
+
+// Cedian: a project window not shown stays ordered in, clear and passing clicks through, rather
+// than ordered out: macOS plays its window-opening animation (a pop) each time an ordered-out
+// window comes back, which a project tab switch must not show. One brought forward some other
+// way (Mission Control, Cmd+`) shows again.
+export function cedianHideWindow(win: electron.BrowserWindow): void {
+	win.setOpacity(0);
+	win.setIgnoreMouseEvents(true);
+	win.once('focus', () => cedianShowWindow(win));
+}
+
+export function cedianShowWindow(win: electron.BrowserWindow): void {
+	if (!win.isDestroyed()) {
+		win.setIgnoreMouseEvents(false);
+		win.setOpacity(1);
+	}
+}
+
+/**
+ * Cedian: set by a project tab switch for the window it opens next: that window starts clear in
+ * `bounds`, and once its workbench is drawn it shows and the window `from` hides, in one step, so
+ * neither macOS's opening animation nor a window still loading is ever on screen.
+ */
+export const cedianQuietOpen: { next?: { from: number; bounds?: Rectangle; at: number } } = {};
+
+/** Cedian: the windows opened clear, by id, each with the step that shows it (revealQuietWindow). */
+export const cedianQuietWindows = new Map<number, () => void>();
