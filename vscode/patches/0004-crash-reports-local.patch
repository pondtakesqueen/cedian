@@ -93,6 +93,11 @@ perf.mark('code/willStartCrashReporter');
 // * --disable-crash-reporter command line parameter is not set
 //
 // Disable crash reporting in all other cases.
+// Cedian (spec §9 Telemetry): crash reports stay on this machine, in ~/Library/Logs/Cedian on
+// macOS, and are never uploaded; --disable-crash-reporter turns them off.
+if (!args['crash-reporter-directory'] && process.platform === 'darwin' && !args['disable-crash-reporter']) {
+	args['crash-reporter-directory'] = path.join(os.homedir(), 'Library', 'Logs', product.nameShort ?? 'Cedian');
+}
 if (args['crash-reporter-directory'] || (argvConfig['enable-crash-reporter'] && !args['disable-crash-reporter'])) {
 	configureCrashReporter();
 }
